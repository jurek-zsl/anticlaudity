#!/usr/bin/env python3
"""anticlaudity: delegate bulk reading / mechanical work from Claude Code to the
Antigravity CLI (`agy`), returning a compact structured result.

  anticlaudity "task" [--path P]... [--model M] [--effort E] [--write]
  anticlaudity "task" --path BIG_DIR --dry-run     # show the chunk plan, run nothing
  anticlaudity stats [--days N] [--json]

Big scopes are split into chunks that run in parallel; a chunk that times out or
returns nothing is retried and then split in half, so one bad call no longer
sinks the whole job. Read-only (agy --mode plan) by default. Every call is
logged to a ledger so the savings can be estimated. Stdlib only; Python 3.8+.
"""
import argparse
import concurrent.futures as cf
import json
import math
import os
import re
import signal
import subprocess
import sys
import tempfile
import threading
import time

LEDGER = os.environ.get(
    "ANTICLAUDITY_LEDGER", os.path.expanduser("~/.anticlaudity/ledger.jsonl")
)
AGY = os.environ.get("ANTICLAUDITY_AGY", "agy")
DEFAULT_MODEL = os.environ.get("ANTICLAUDITY_MODEL", "gemini-3.8-flash-medium")
CHUNK_TOKENS = int(os.environ.get("ANTICLAUDITY_CHUNK_TOKENS", "40000"))
JOBS = int(os.environ.get("ANTICLAUDITY_JOBS", "3"))
MAX_FILES_PER_CHUNK = 30
MAX_SPLIT_DEPTH = 3
BYTES_PER_TOKEN = 4  # rough estimate
KILL_GRACE = int(os.environ.get("ANTICLAUDITY_GRACE", "30"))  # extra secs past --print-timeout
CALL_OVERHEAD_TOKENS = 300  # the command + the result framing Claude itself pays for
# Claude usually greps/narrows before reading, so it would not have read the whole
# scope. `stats` reports a conservative figure using this fraction, and an upper bound.
READ_FRACTION = float(os.environ.get("ANTICLAUDITY_READ_FRACTION", "0.5"))

SKIP_DIRS = {".git", "node_modules", ".venv", "venv", "__pycache__", "dist", "build",
             ".next", ".idea", ".gradle", "target", "Pods", ".cache"}
SKIP_NAMES = {"package-lock.json", "yarn.lock", "pnpm-lock.yaml", "Cargo.lock",
              "poetry.lock", "Pipfile.lock", ".DS_Store"}
BINARY_EXT = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico", ".pdf", ".zip", ".gz",
              ".tar", ".tgz", ".7z", ".mp3", ".mp4", ".mov", ".wav", ".ogg", ".ttf",
              ".otf", ".woff", ".woff2", ".exe", ".dll", ".so", ".dylib", ".bin",
              ".class", ".jar", ".pyc", ".rbxm", ".rbxl", ".fbx", ".blend", ".psd",
              ".svg", ".map", ".min.js"}

SCHEMA = {
    "type": "object",
    "properties": {
        "summary": {"type": "string"},
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "line": {"type": "integer"},
                    "note": {"type": "string"},
                },
                "required": ["path", "note"],
            },
        },
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "caveats": {"type": "string"},
        "changed_files": {"type": "array", "items": {"type": "string"}},
    },
    "required": ["summary", "findings", "confidence"],
}
CONF_RANK = {"low": 0, "medium": 1, "high": 2}

PROMPT = """You are a research/worker assistant for another AI agent that will NOT re-read your sources, so accuracy matters more than speed.

TASK:
{task}

SCOPE{part} (this is your complete scope; read these, do not wander outside them):
{scope}

RULES:
- {mode_rule}
- Report only what you verified in the files. Never guess or invent paths, line numbers or quotes.
- Every finding needs an absolute `path` and a `line` when applicable. Keep each `note` under 40 words.
- `summary`: at most {summary_words} words, answering the task directly.
- At most {max_findings} findings; prefer the most relevant ones.
- If you could not find something or could not cover the whole scope, say so in `caveats` and lower `confidence`.
- Set `confidence` honestly: high only if you covered the whole scope and the answer is unambiguous.
- Your final message must be the JSON object only.
"""


# --------------------------------------------------------------------------- scope

def _is_binary(path):
    if os.path.splitext(path)[1].lower() in BINARY_EXT or path.endswith(".min.js"):
        return True
    try:
        with open(path, "rb") as f:
            return b"\0" in f.read(2048)
    except OSError:
        return True


def gather_files(paths):
    """Expand paths into [(abs_path, est_tokens)]. Explicit files are always kept;
    directories are walked, skipping vendor dirs, lockfiles and binaries."""
    out, seen = [], set()

    def add(p):
        if p in seen:
            return
        seen.add(p)
        try:
            out.append((p, max(os.path.getsize(p) // BYTES_PER_TOKEN, 1)))
        except OSError:
            pass

    for p in paths:
        if os.path.isfile(p):
            add(p)
            continue
        for root, dirs, names in os.walk(p):
            dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)
            for n in sorted(names):
                fp = os.path.join(root, n)
                if n in SKIP_NAMES or _is_binary(fp):
                    continue
                add(fp)
    return out


def make_chunks(files, budget, max_files=MAX_FILES_PER_CHUNK):
    """Greedy, order-preserving batches (siblings stay together). An oversize file
    gets a chunk of its own."""
    chunks, cur, cur_tok = [], [], 0
    for f in files:
        if cur and (cur_tok + f[1] > budget or len(cur) >= max_files):
            chunks.append(cur)
            cur, cur_tok = [], 0
        cur.append(f)
        cur_tok += f[1]
    if cur:
        chunks.append(cur)
    return chunks


# --------------------------------------------------------------------------- ledger

def log_ledger(entry):
    try:
        os.makedirs(os.path.dirname(LEDGER), exist_ok=True)
        with open(LEDGER, "a") as f:
            f.write(json.dumps(entry) + "\n")
    except OSError as e:
        print("anticlaudity: could not write ledger: %s" % e, file=sys.stderr)


def classify_error(msg):
    m = (msg or "").lower()
    if "conflicts with --effort" in m or "model flag" in m:
        return "model_effort_conflict"
    if "timed out" in m or "timeout" in m:
        return "timeout"
    if "not found on path" in m:
        return "agy_missing"
    if "no structured output" in m or "no output" in m:
        return "no_output"
    if "not logged" in m or "auth" in m:
        return "auth"
    if "non-json" in m:
        return "non_json"
    if "status error" in m or "agy status" in m:
        return "agy_error"
    if "path does not exist" in m or "empty task" in m or "scope too large" in m:
        return "bad_input"
    return "other"


def fail(msg, entry=None, code=1, **extra):
    out = {"status": "error", "error": msg}
    out.update(extra)
    if entry is not None:
        entry.update(status="error", error=msg, error_kind=classify_error(msg))
        log_ledger(entry)
    print(json.dumps(out))
    sys.exit(code)


# --------------------------------------------------------------------------- agy

def model_args(model, effort):
    """agy rejects `--model gemini-...-medium --effort X` (the suffix already is the
    effort). Fold --effort into the suffix where possible, otherwise drop it."""
    m = re.match(r"^(.*)-(low|medium|high)$", model)
    if not effort:
        return model, []
    if m:
        if effort in ("low", "medium", "high"):
            return "%s-%s" % (m.group(1), effort), []
        return model, []  # xhigh/max can't be expressed on a suffixed model
    return model, ["--effort", effort]


def parse_json_text(txt):
    """Pull a JSON object out of free text (plain, fenced, or after prose)."""
    txt = (txt or "").strip()
    if not txt:
        return None
    cands = [txt]
    fence = re.search(r"```(?:json)?\s*(\{.*\})\s*```", txt, re.S)
    if fence:
        cands.append(fence.group(1))
    last = txt.splitlines()[-1].strip() if txt.splitlines() else ""
    if last.startswith("{"):
        cands.append(last)
    i, j = txt.find("{"), txt.rfind("}")
    if 0 <= i < j:
        cands.append(txt[i:j + 1])
    for c in cands:
        try:
            v = json.loads(c)
        except ValueError:
            continue
        if isinstance(v, dict):
            return v
    return None


def normalize(result, fallback_text=""):
    findings = []
    for f in result.get("findings") or []:
        if isinstance(f, dict) and f.get("path") and f.get("note"):
            findings.append({k: f[k] for k in ("path", "line", "note") if k in f})
    conf = result.get("confidence")
    return {
        "summary": str(result.get("summary") or fallback_text or "").strip(),
        "findings": findings,
        "confidence": conf if conf in CONF_RANK else "low",
        "caveats": str(result.get("caveats") or "").strip(),
        "changed_files": [str(x) for x in (result.get("changed_files") or [])],
    }


class Meter:
    """Thread-safe accumulator for Antigravity-side usage and retry counts."""

    def __init__(self):
        self.lock = threading.Lock()
        self.tokens = 0
        self.attempts = 0
        self.retries = 0
        self.splits = 0

    def add(self, usage=None, retry=False, split=False):
        with self.lock:
            self.attempts += 1
            self.tokens += int((usage or {}).get("total_tokens") or 0)
            self.retries += int(retry)
            self.splits += int(split)


def call_agy(cmd, cwd, timeout):
    """One agy invocation. Returns (kind, payload, usage); kind is one of
    ok | text | timeout | agy_error | no_output | non_json | fatal."""
    try:
        proc = subprocess.Popen(cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                text=True, start_new_session=True)
    except FileNotFoundError:
        return "fatal", "agy not found on PATH (set ANTICLAUDITY_AGY)", None
    t0 = time.time()
    try:
        stdout, stderr = proc.communicate(timeout=timeout + KILL_GRACE)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)  # agy spawns helpers; kill the group
        except OSError:
            pass
        proc.communicate()
        return "timeout", "agy timed out after %ds" % timeout, None
    try:
        raw = json.loads(stdout)
    except ValueError:
        return "non_json", "agy returned non-JSON (exit %d): %s" % (
            proc.returncode, (stderr or stdout)[:300]), None
    usage = raw.get("usage")
    status = raw.get("status")
    resp = raw.get("response")
    resp = resp if isinstance(resp, str) else ""
    if status != "SUCCESS":
        if "print timeout" in (resp + (stderr or "")).lower():
            return "timeout", "agy print-timeout hit", usage
        msg = "agy status %s: %s" % (status, (resp or stderr or "")[:300])
        used = int((usage or {}).get("total_tokens") or 0)
        if time.time() - t0 < 30 and used == 0:
            return "fast_error", msg, usage  # config/auth/rate-limit style; splitting won't help
        return "agy_error", msg, usage
    so = raw.get("structured_output")
    if isinstance(so, dict):
        return "ok", so, usage
    parsed = parse_json_text(resp)
    if parsed is not None:
        return "ok", parsed, usage
    if resp.strip():
        return "text", resp.strip(), usage
    return "no_output", "agy gave no structured output and an empty response", usage


# --------------------------------------------------------------------------- run

class Job:
    def __init__(self, args, cwd, roots, schema_path, meter, total_chunks):
        self.args, self.cwd, self.roots = args, cwd, roots
        self.schema_path, self.meter, self.total = schema_path, meter, total_chunks
        self.mode = "accept-edits" if args.write else "plan"
        self.model, self.effort_args = model_args(args.model, args.effort)
        self.per_chunk = max(3, math.ceil(args.max_findings / max(total_chunks, 1)))
        self.done = 0
        self.lock = threading.Lock()

    def prompt(self, files, idx):
        a = self.args
        mode_rule = (
            "You may edit files, but only what the task requires. List every file you changed in `changed_files`."
            if a.write else "Read-only: do not modify any files or run state-changing commands.")
        if files:
            scope = "\n".join("- " + f[0] for f in files)
        else:
            scope = "- the current working directory (%s)" % self.cwd
        part = " (part %d of %d of a larger job; other parts are handled separately)" % (
            idx + 1, self.total) if self.total > 1 else ""
        return PROMPT.format(
            task=self.task, scope=scope, part=part, mode_rule=mode_rule,
            max_findings=self.per_chunk if self.total > 1 else a.max_findings,
            summary_words=120 if self.total > 1 else 200)

    def command(self, files, idx):
        cmd = [AGY, "-p", self.prompt(files, idx), "--mode", self.mode, "--model", self.model,
               "--output-format", "json"] + self.effort_args
        cmd += ["--print-timeout", "%ds" % self.args.timeout, "--json-schema", self.schema_path]
        added = set()
        for r in self.roots:
            outside = not (r == self.cwd or r.startswith(self.cwd + os.sep))
            if outside and r not in added and (
                    not files or any(f[0] == r or f[0].startswith(r + os.sep) for f in files)):
                cmd += ["--add-dir", r]
                added.add(r)
        return cmd

    def run_chunk(self, files, idx, depth=0):
        """Returns (result|None, error|None, uncovered_files). Retries once on empty
        output, then splits the chunk in half; never loses work already done."""
        last_err = "unknown error"
        for attempt in range(2):
            kind, payload, usage = call_agy(self.command(files, idx), self.cwd, self.args.timeout)
            self.meter.add(usage, retry=attempt > 0)
            if kind == "fatal":
                raise RuntimeError(payload)
            if kind == "ok":
                return normalize(payload), None, []
            if kind == "text":
                r = normalize({"confidence": "low"}, fallback_text=payload[:1500])
                r["caveats"] = "agy returned unstructured text; treat as low confidence"
                return r, None, []
            last_err = payload
            if kind == "fast_error":
                if attempt == 0:
                    time.sleep(5)  # maybe a transient rate limit; one more go
                    continue
                return None, last_err, [f[0] for f in files]
            if kind in ("timeout", "agy_error", "non_json"):
                break  # same-size retry would just repeat it; split instead
        if len(files) > 1 and depth < MAX_SPLIT_DEPTH:
            self.meter.add(split=True)
            mid = len(files) // 2
            parts = [self.run_chunk(files[:mid], idx, depth + 1),
                     self.run_chunk(files[mid:], idx, depth + 1)]
            ok = [p[0] for p in parts if p[0]]
            if ok:
                merged = merge_results(ok)
                lost = [u for p in parts for u in p[2]]
                errs = [p[1] for p in parts if p[1]]
                return merged, (errs[0] if lost else None), lost
            return None, last_err, [u for p in parts for u in p[2]] or [f[0] for f in files]
        return None, last_err, [f[0] for f in files] if files else []

    def tick(self, idx, ok):
        with self.lock:
            self.done += 1
            print("[anticlaudity] chunk %d/%d %s" % (self.done, self.total, "ok" if ok else "FAILED"),
                  file=sys.stderr, flush=True)


def merge_results(results, labels=None):
    if len(results) == 1:
        return results[0]
    summ = []
    for i, r in enumerate(results):
        if r["summary"]:
            summ.append(("[%s] " % labels[i] if labels else "") + r["summary"])
    caveats = [r["caveats"] for r in results
               if r["caveats"] and not re.match(r"(?i)^\W*(none|n/a|no caveats)\b", r["caveats"])]
    return {
        "summary": "\n".join(summ),
        "findings": [f for r in results for f in r["findings"]],
        "confidence": min((r["confidence"] for r in results), key=lambda c: CONF_RANK[c]),
        "caveats": " | ".join(dict.fromkeys(caveats)),
        "changed_files": sorted({c for r in results for c in r["changed_files"]}),
    }


def run_delegate(args):
    task = sys.stdin.read() if args.task == "-" else args.task
    if not task or not task.strip():
        fail("empty task")
    task = task.strip()

    cwd = os.path.abspath(args.cwd or os.getcwd())
    paths = []
    for p in args.path:
        ap = os.path.abspath(os.path.join(cwd, p))
        if not os.path.exists(ap):
            fail("path does not exist: %s" % ap)
        paths.append(ap)
    roots = sorted({p if os.path.isdir(p) else os.path.dirname(p) for p in paths})

    files = gather_files(paths) if paths else []
    scope_tokens = sum(f[1] for f in files)
    chunks = make_chunks(files, args.chunk_tokens) if files else [[]]
    n = len(chunks)

    entry = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "task": task[:200], "cwd": cwd, "paths": paths,
        "model": args.model, "mode": "accept-edits" if args.write else "plan",
        "scope_files": len(files), "scope_tokens_est": scope_tokens, "chunks": n,
    }

    if args.dry_run:
        print(json.dumps({
            "status": "dry-run", "files": len(files), "scope_tokens_est": scope_tokens,
            "chunks": n, "jobs": 1 if args.write else min(args.jobs, n),
            "chunk_plan": [{"files": len(c), "tokens_est": sum(f[1] for f in c),
                            "first": c[0][0] if c else None} for c in chunks],
        }, indent=2))
        return
    if n > args.max_chunks:
        fail("scope too large: %d files / ~%dk tokens needs %d chunks (limit %d). Narrow --path, "
             "or raise --max-chunks / --chunk-tokens." % (len(files), scope_tokens // 1000, n,
                                                           args.max_chunks), entry)

    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as sf:
        json.dump(SCHEMA, sf)
        schema_path = sf.name

    meter = Meter()
    job = Job(args, cwd, roots, schema_path, meter, n)
    job.task = task
    t0 = time.time()
    try:
        def work(i):
            res, err, lost = job.run_chunk(chunks[i], i)
            job.tick(i, res is not None)
            return i, res, err, lost

        outcomes = {}
        workers = 1 if args.write else max(1, min(args.jobs, n))
        with cf.ThreadPoolExecutor(max_workers=workers) as ex:
            for i, res, err, lost in ex.map(work, range(n)):
                outcomes[i] = (res, err, lost)
    except RuntimeError as e:  # agy missing
        fail(str(e), entry)
    finally:
        try:
            os.unlink(schema_path)
        except OSError:
            pass
    entry["wall_seconds"] = round(time.time() - t0, 1)
    entry["agy_usage"] = {"total_tokens": meter.tokens}
    entry.update(attempts=meter.attempts, retries=meter.retries, splits=meter.splits)

    good = [(i, outcomes[i][0]) for i in range(n) if outcomes[i][0]]
    errors = [outcomes[i][1] for i in range(n) if outcomes[i][1]]
    uncovered = [u for i in range(n) for u in outcomes[i][2]]
    entry["chunks_failed"] = n - len(good)
    if not good:
        fail(errors[0] if errors else "all chunks failed", entry,
             uncovered_files=uncovered[:20])

    labels = ["%d/%d" % (i + 1, n) for i, _ in good] if n > 1 else None
    merged = merge_results([r for _, r in good], labels)
    partial = bool(uncovered) or len(good) < n
    lost_set = set(uncovered)
    covered_tokens = scope_tokens - sum(f[1] for c in chunks for f in c if f[0] in lost_set)
    if partial:
        merged["confidence"] = "low"
        note = "INCOMPLETE: %d file(s) were not covered (agy failed on them: %s). Read them yourself." % (
            len(uncovered), errors[0] if errors else "see ledger")
        merged["caveats"] = (merged["caveats"] + " | " if merged["caveats"] else "") + note

    out = {"status": "partial" if partial else "ok", "model": args.model, "mode": entry["mode"],
           "duration_s": entry["wall_seconds"]}
    if n > 1:
        out["chunks"] = n
    out.update({k: v for k, v in merged.items() if v not in ("", [], None)})
    if uncovered:
        out["uncovered_files"] = uncovered[:30]
    out_txt = json.dumps(out, indent=2)

    result_tokens = len(out_txt) // BYTES_PER_TOKEN
    saved = max(covered_tokens - result_tokens - CALL_OVERHEAD_TOKENS, 0)
    out["est_claude_tokens_saved"] = saved
    out_txt = json.dumps(out, indent=2)
    entry.update(status=out["status"], confidence=merged["confidence"],
                 result_tokens_est=result_tokens, covered_tokens_est=covered_tokens,
                 saved_tokens_est=saved)
    log_ledger(entry)
    print(out_txt)


# --------------------------------------------------------------------------- stats

def load_rows(days):
    if not os.path.exists(LEDGER):
        return None
    cutoff = time.time() - days * 86400
    rows = []
    with open(LEDGER) as f:
        for line in f:
            try:
                r = json.loads(line)
                ts = time.mktime(time.strptime(r["ts"][:19], "%Y-%m-%dT%H:%M:%S"))
            except (ValueError, KeyError):
                continue
            if ts >= cutoff:
                r["_ts"] = ts
                rows.append(r)
    return rows


def row_saved(r):
    """Tokens kept out of Claude's context by one ledger row (upper bound)."""
    if "saved_tokens_est" in r:
        return r["saved_tokens_est"]
    if r.get("status") != "ok":  # legacy rows
        return 0
    return max(r.get("scope_tokens_est", 0) - r.get("result_tokens_est", 0) - CALL_OVERHEAD_TOKENS, 0)


def fmt(n):
    return "{:,}".format(int(n))


def run_stats(args):
    rows = load_rows(args.days)
    if rows is None:
        print("No ledger yet at %s" % LEDGER)
        return
    ok = [r for r in rows if r.get("status") == "ok"]
    part = [r for r in rows if r.get("status") == "partial"]
    bad = [r for r in rows if r.get("status") == "error"]
    useful = ok + part
    upper = sum(row_saved(r) for r in useful)
    conservative = int(upper * READ_FRACTION)
    scope = sum(r.get("scope_tokens_est", 0) for r in useful)
    res = sum(r.get("result_tokens_est", 0) for r in useful)
    agy_tot = sum((r.get("agy_usage") or {}).get("total_tokens", 0) for r in rows)
    wasted = sum((r.get("agy_usage") or {}).get("total_tokens", 0) for r in bad)
    kinds = {}
    for r in bad:
        k = r.get("error_kind") or classify_error(r.get("error"))
        kinds[k] = kinds.get(k, 0) + 1
    days = {}
    for r in useful:
        d = time.strftime("%Y-%m-%d", time.localtime(r["_ts"]))
        days[d] = days.get(d, 0) + row_saved(r)

    if args.json:
        print(json.dumps({
            "days": args.days, "calls": len(rows), "ok": len(ok), "partial": len(part),
            "failed": len(bad), "claude_tokens_saved_upper": upper,
            "claude_tokens_saved_conservative": conservative, "read_fraction": READ_FRACTION,
            "scope_tokens": scope, "result_tokens": res, "agy_tokens": agy_tot,
            "failures_by_kind": kinds, "saved_by_day": days}, indent=2))
        return

    print("anticlaudity stats - last %d days" % args.days)
    print("  Calls: %d  (%d ok, %d partial, %d failed)" % (len(rows), len(ok), len(part), len(bad)))
    if not useful:
        if kinds:
            print("  Failures: " + ", ".join("%s x%d" % kv for kv in sorted(kinds.items())))
        return
    print()
    print("  Claude tokens kept out of your context (estimate)")
    print("    likely:      ~%s   (assumes Claude would have read ~%d%% of the scope)" % (
        fmt(conservative), int(READ_FRACTION * 100)))
    print("    upper bound: ~%s   (Claude would have read all of it)" % fmt(upper))
    print()
    print("  Source handed to Antigravity:  ~%s tokens" % fmt(scope))
    print("  Results returned to Claude:    ~%s tokens" % fmt(res))
    if scope:
        print("  Compression:                   %.0fx" % (scope / max(res, 1)))
    print("  Antigravity-side tokens spent: %s  (%s of it on failed calls)" % (fmt(agy_tot), fmt(wasted)))
    walls = sorted(r.get("wall_seconds", 0) for r in useful)
    print("  Median wall time: %.0fs" % walls[len(walls) // 2])
    chunked = [r for r in useful if r.get("chunks", 1) > 1]
    if chunked:
        print("  Chunked calls: %d (retries %d, splits %d)" % (
            len(chunked), sum(r.get("retries", 0) for r in chunked), sum(r.get("splits", 0) for r in chunked)))
    if kinds:
        print("  Failures: " + ", ".join("%s x%d" % kv for kv in sorted(kinds.items(), key=lambda kv: -kv[1])))
    low = [r for r in useful if r.get("confidence") == "low"]
    if low:
        print("  Low-confidence results: %d" % len(low))
    small = [r for r in useful if r.get("scope_tokens_est", 0) < 5000]
    if small:
        print("  Warning: %d calls had scope < ~5k tokens; probably not worth delegating." % len(small))
    if len(days) > 1:
        print()
        print("  Saved per day (upper bound):")
        for d in sorted(days)[-7:]:
            print("    %s  ~%s" % (d, fmt(days[d])))
    print()
    print("  Estimates use ~4 bytes/token on the files handed over; they are rough.")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "stats":
        ap = argparse.ArgumentParser(prog="anticlaudity stats")
        ap.add_argument("stats")
        ap.add_argument("--days", type=int, default=7)
        ap.add_argument("--json", action="store_true", help="machine-readable output")
        run_stats(ap.parse_args())
        return
    ap = argparse.ArgumentParser(
        prog="anticlaudity",
        description="Delegate bulk reading/mechanical work to Antigravity (agy).")
    ap.add_argument("task", help="what to do ('-' reads the task from stdin)")
    ap.add_argument("--path", action="append", default=[], help="file/dir to read (repeatable)")
    ap.add_argument("--cwd", help="working directory for agy (default: current dir)")
    ap.add_argument("--model", default=DEFAULT_MODEL)
    ap.add_argument("--effort", choices=["low", "medium", "high", "xhigh", "max"])
    ap.add_argument("--timeout", type=int, default=420, help="seconds per agy call (default 420)")
    ap.add_argument("--max-findings", type=int, default=15,
                    help="approximate total findings (split across chunks)")
    ap.add_argument("--chunk-tokens", type=int, default=CHUNK_TOKENS,
                    help="target est. tokens of source per agy call (default %d)" % CHUNK_TOKENS)
    ap.add_argument("--jobs", type=int, default=JOBS, help="parallel agy calls (default %d)" % JOBS)
    ap.add_argument("--max-chunks", type=int, default=20,
                    help="refuse scopes needing more chunks than this (default 20)")
    ap.add_argument("--dry-run", action="store_true", help="print the chunk plan and exit")
    ap.add_argument("--write", action="store_true", help="allow edits (agy --mode accept-edits)")
    run_delegate(ap.parse_args())


if __name__ == "__main__":
    main()
